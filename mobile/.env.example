# Copy to .env (gitignored). Never commit real keys.
# Full Console steps: docs/rotate-google-maps-keys.md
# Project: flagshiptowing-9569a (FlagshipTowing) — same as Firebase.

# Places + Geocoding REST (AddressSearchModal, CityPicker, weather geocode).
# Console: API restriction only — Places API + Geocoding API.
# Do NOT add Android/iOS app restrictions; React Native fetch will fail them.
GOOGLE_PLACES_API_KEY=

# Maps SDK for Android (AndroidManifest). Package com.genesysglobal.flagship
# plus debug / upload / Play App Signing SHA-1 fingerprints.
GOOGLE_MAPS_ANDROID_API_KEY=

# Maps SDK for iOS (Info.plist / AppDelegate). Bundle ID:
# com.pixelgenesys.flagshiptowing
GOOGLE_MAPS_IOS_API_KEY=
