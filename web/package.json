{
  "name": "membership-flagship-portal",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dev.config.js",
    "start": "vite --config vite.dev.config.js",
    "build": "node scripts/build.mjs",
    "build:css": "vite build --config vite.portal.config.js",
    "preview": "vite preview --config vite.preview.config.js --host 0.0.0.0 --port 60030",
    "pm2": "pm2 start ./node_modules/vite/bin/vite.js --name \"flagship-member-60030-staging\" -- preview --config vite.preview.config.js --host 0.0.0.0 --port 60030",
    "port-killer": "kill -9 $(lsof -t -i:60030) 2>/dev/null || true"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.4"
  }
}
