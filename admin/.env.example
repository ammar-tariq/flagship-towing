# Admin Flagship env (Vite)
# Copy to .env (gitignored). Never commit real keys.

VITE_API_BASE_URL=https://apis.flagshiptowingadmin.us/live
VITE_IMAGE_BASE_URL=https://apis.flagshiptowingadmin.us/live/
VITE_APP_MODE=dev
VITE_VAPID_KEY=
# VITE_BASE=/

# Maps JavaScript API + Places API. Same key as membershipFlagship.
# Full Console steps: docs/rotate-google-maps-keys.md
VITE_GOOGLE_MAPS_KEY=

# Firebase web app (push). Same project as the mobile app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
