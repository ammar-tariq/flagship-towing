<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Code</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Nunito', sans-serif;
            background-color: #f4f4f7;
            font-size: 15px;
            line-height: 1.5;
            color: #333;
        }
        .email-wrap {
            max-width: 560px;
            margin: 0 auto;
            padding: 24px 16px;
        }
        .card {
            background: #fff;
            border-radius: 8px;
            padding: 28px 24px;
        }
        .brand {
            text-align: center;
            margin-bottom: 20px;
        }
        .brand img {
            max-height: 44px;
            width: auto;
        }
        .divider {
            height: 3px;
            background: #0118FF;
            margin: 0 0 20px 0;
            border-radius: 2px;
        }
        .greeting {
            font-size: 16px;
            color: #333;
            margin: 0 0 16px 0;
        }
        .message {
            margin: 0 0 20px 0;
            color: #444;
        }
        .message strong {
            color: #0118FF;
        }
        .small {
            font-size: 13px;
            color: #666;
            margin: 16px 0 0 0;
        }
        .sign-off {
            margin-top: 24px;
            font-size: 14px;
            color: #555;
        }
        .footer {
            text-align: center;
            font-size: 12px;
            color: #999;
            padding: 20px 0 0;
        }
        .code-box {
            font-size: 24px;
            font-weight: 700;
            background-color: #f9f9f9;
            padding: 15px;
            text-align: center;
            letter-spacing: 2px;
            border-radius: 6px;
            margin: 20px 0;
            color: #0118FF;
        }
    </style>
</head>

<body>
    <div class="email-wrap">
        <div class="card">
            <div class="brand">
                <img src="https://static.spacecrafted.com/f3a81e09e3c348aaa519f655fc613f4f/i/c677f51b921b42cc8caee4de7e4cb426/1/5feFb8zhrk/FTLogoLongNew.png?dpr=2" alt="Flagship Towing">
            </div>
            <div class="divider"></div>

            <p class="greeting">Hello,</p>

            <p class="message">
                We received a request to reset your password. Please use the code below to proceed. This code will
                expire in 1 hour.
            </p>

            <div class="code-box">
                <%= otp %>
            </div>

            <p class="message">
                If you did not request a password reset, you can ignore this email.
            </p>

            <p class="sign-off">
                Warm regards,<br>
                <strong>Flagship Towing Team</strong>
            </p>

            <div class="footer">
                © <%= new Date().getFullYear() %> Flagship Towing. All rights reserved.
            </div>
        </div>
    </div>
</body>

</html>