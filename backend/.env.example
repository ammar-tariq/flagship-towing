# Copy to .env and fill in values.
# Variable names match process.env usage in backendFlagship/src (and your live .env).

# MongoDB — APP_NAME is the database name unless DB_NAME is set
DB_CONNECTION_STRING=
APP_NAME=flagship-towing
# DB_NAME=flagshipTowing-staging

# Legacy URL slug for /{API_PATH}/v1/api. Ignored when API_PREFIX is set.
# API_PATH=flagship-towing-staging

# Public path nginx forwards (trailing slash strips it before Node). Clients call BASE_URL + API_PREFIX.
API_PREFIX=/live

# Server
PORT=5001

# Public API origin (scheme + host, no path, no trailing slash).
# Client API base is ${BASE_URL}${API_PREFIX} → https://apis.flagshiptowingadmin.us/live
BASE_URL=https://apis.flagshiptowingadmin.us

# Optional absolute path for uploaded files (multer + GET /uploads).
# Default: <folder containing app.js>/uploads
# UPLOADS_DIR=/root/projects/flagshipTowing-staging/uploads

# Optional path prefix before /uploads in public file URLs.
# When unset, API_PREFIX is used so files are https://apis.flagshiptowingadmin.us/live/uploads/...
# PUBLIC_UPLOADS_PREFIX=

# Optional override when BASE_URL is not the client-visible origin
# PUBLIC_ORIGIN=

# Membership web portal (no trailing slash). Used on checkout success/cancel HTML CTAs.
# MEMBERSHIP_PORTAL_URL=https://members.example.com
# PUBLIC_MEMBERSHIP_URL=

# JWT (required — src/helpers/token.js)
JWT_SECRET_KEY=
# Short-lived access token (default 15m). Legacy alias: JWT_EXPIRES_IN
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime in days (default 30)
JWT_REFRESH_EXPIRES_IN_DAYS=30
# bcrypt cost (default 12)
BCRYPT_ROUNDS=12

# Google Sign-In — REQUIRED for Google social login (comma-separated OAuth client IDs / audiences)
GOOGLE_CLIENT_IDS=your-ios-client.apps.googleusercontent.com,your-android-client.apps.googleusercontent.com,your-web-client.apps.googleusercontent.com

# Comma-separated browser origins allowed for CORS / Socket.IO.
# When unset, CORS stays permissive (backward compatible). Set this in production.
# CORS_ORIGINS=https://admin.example.com,https://members.example.com,http://localhost:5173

# Stripe (src/helpers/stripe.js)
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_DEV=
STRIPE_WEBHOOK_KEY=
STRIPE_WEBHOOK_SECRET_DEV=

# Apple Sign In — iOS bundle id (src/helpers/appleAuth.js). Do not use CLIENT_ID here.
APPLE_CLIENT_ID=com.pixelgenesys.flagshiptowing

# Apple Wallet passes (src/helpers/wallet.js)
APPLE_PASS_TYPE_ID=pass.com.flagshiptowing.membership
APPLE_TEAM_ID=
APPLE_PASS_KEY_PASSPHRASE=

# Google Wallet (src/helpers/wallet.js — service account file: certs/google-wallet-service-account.json)
GOOGLE_WALLET_ISSUER_ID=
# Optional HTTPS image URLs — only set when publicly reachable (404s reject the pass)
# GOOGLE_WALLET_LOGO_URL=
# GOOGLE_WALLET_HERO_URL=

# SMTP fallback when Gmail OAuth is not configured (src/helpers/email.js)
EMAIL_FORMAIL=
EMAILPASSWORD_FORMAIL=

# Gmail OAuth (src/helpers/email.js, gmailOAuthFlow.js, scripts/gmail-oauth-setup.js)
GMAIL_OAUTH_SETUP_SECRET=
GMAIL_USER=
GMAIL_FROM=
GMAIL_REFRESH_TOKEN=
# GMAIL_OAUTH_CREDENTIALS_PATH=certs/googleOAuth.json
# GMAIL_OAUTH_TOKENS_PATH=certs/googleOAuth.tokens.json
# GMAIL_OAUTH_REDIRECT_URI=
# GMAIL_OAUTH_REDIRECT_PORT=8765
# GMAIL_OAUTH_USE_LOCALHOST=false

# NWS / weather proxy (src/helpers/weatherService.js) — User-Agent required by api.weather.gov
# NWS_USER_AGENT=FlagshipTowing/1.0 (support@flagshiptowing.com)

# Present in some .env files but not read by backend code (safe to omit):
# CLIENT_SECRET=
# REDIRECT_URI=
# ENVIRONMENT=
# PROTECTED=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
